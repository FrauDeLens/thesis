rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: users can read and write their own document; teachers can read student documents
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Questions collection: anyone can read questions, teachers can create/edit/delete
    match /questions/{questionId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
