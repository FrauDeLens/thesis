rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStudentRole() {
      return request.resource.data.role == 'student';
    }

    function roleUnchanged() {
      return !('role' in request.resource.data) || request.resource.data.role == resource.data.role;
    }

    function isNotReservedAdmin(id) {
      return id != 'admin' && id != 'admin1' && id != 'admin2' && id != 'teacher';
    }

    function validProgress(prog) {
      return prog.truePoints is number 
        && prog.truePoints >= 0 
        && prog.truePoints <= 100000
        && (!('shop' in prog) || (
          prog.shop.maxHp is number && prog.shop.maxHp <= 10
          && prog.shop.freeHints is number && prog.shop.freeHints <= 5
        ))
        && (!('unlocks' in prog) || prog.unlocks.easy == true);
    }

    // Users collection: student registration, updates, and teacher management
    match /users/{userId} {
      // Allow reading user profiles for authentication, leaderboard, and student rosters
      allow read: if true;

      // Registration: New accounts can only be created with role 'student' and cannot use reserved names
      allow create: if isStudentRole() 
        && isNotReservedAdmin(userId)
        && (!('progress' in request.resource.data) || validProgress(request.resource.data.progress));

      // Updates: Role cannot be escalated; progress and points must respect integrity bounds
      allow update: if roleUnchanged()
        && (!('truePoints' in request.resource.data) || (request.resource.data.truePoints is number && request.resource.data.truePoints <= 100000))
        && (!('progress' in request.resource.data) || validProgress(request.resource.data.progress));

      // Deletions: Administrative accounts can NEVER be deleted
      allow delete: if isNotReservedAdmin(userId) && resource.data.role != 'teacher';
    }

    // Questions collection: Read-only for gameplay; mutations require valid schema
    match /questions/{questionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['title', 'difficulty', 'enemy_id']);
      allow delete: if false;
    }
  }
}
